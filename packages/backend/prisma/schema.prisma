// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Define the seed script
generator seed {
  provider = "prisma-client-js"
  output   = "../generated/prisma-seed"
  seed     = "ts-node prisma/seed/index.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenant model
model Tenant {
  id          String    @id @default(uuid())
  name        String    @unique
  schema      String    @unique
  displayName String
  address     String?
  phone       String?
  email       String?
  logo        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  patients    Patient[]
  scans       Scan[]
}

// User model
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      Role     @default(RECEPTIONIST)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  reports   Report[]
}

// Patient model
model Patient {
  id        String   @id @default(uuid())
  name      String
  dob       DateTime
  mobile    String
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  scans     Scan[]
}

// Scan model
model Scan {
  id          String    @id @default(uuid())
  scanType    ScanType
  bodyPart    String
  description String?
  urgency     Urgency   @default(NORMAL)
  status      Status    @default(PENDING)
  dicomPath   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  reports     Report[]
}

// Report model
model Report {
  id        String   @id @default(uuid())
  findings  String
  impression String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id])
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id])
}

// Enums
enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  TECHNICIAN
}

enum ScanType {
  MRI
  CT
  XRAY
  ULTRASOUND
  OTHER
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
